PORT=8003

# ZegoCloud credentials (server-side only; never expose these in client code)
# Get these from your ZegoCloud project console.
ZEGO_APP_ID=
ZEGO_SERVER_SECRET=

# Admin panel login (admin.html). This is a PLACEHOLDER single-account auth
# scheme, not a real role-based auth system: replace with per-admin accounts
# and persisted sessions before relying on this for real access control.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

PORT=8003

# Postgres connection string for persistent storage (registered users,
# emergency history, admin audit trail). REQUIRED in production on any
# host with an ephemeral filesystem (e.g. Render's free tier) -- without
# it, all accounts and data are wiped on every redeploy/restart, since
# storage falls back to local JSON files that live only on that instance's
# disk. Any standard Postgres provider works: Neon, Supabase, Render
# Postgres, ElephantSQL, etc. all give a free-tier connection string in
# this exact format.
# Example: postgres://user:password@host:5432/dbname
DATABASE_URL=

# ZegoCloud credentials (server-side only; never expose these in client code)
# Get these from your ZegoCloud project console.
ZEGO_APP_ID=
ZEGO_SERVER_SECRET=

# Admin panel (admin.html) sessions are signed JWTs held in an httpOnly
# cookie. Set this to a long random string in production so admin sessions
# survive server restarts (otherwise a random secret is generated at
# startup, which is still secure but invalidates sessions on every restart).
ADMIN_JWT_SECRET=

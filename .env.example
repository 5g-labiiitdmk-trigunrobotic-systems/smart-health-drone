PORT=8003

# ZegoCloud credentials (server-side only; never expose these in client code)
# Get these from your ZegoCloud project console.
ZEGO_APP_ID=
ZEGO_SERVER_SECRET=

# Admin panel (admin.html) sessions are signed JWTs held in an httpOnly
# cookie. Set this to a long random string in production so admin sessions
# survive server restarts (otherwise a random secret is generated at
# startup, which is still secure but invalidates sessions on every restart).
ADMIN_JWT_SECRET=
